{
  "name": "pi-splinter",
  "version": "0.1.0",
  "description": "A grab bag of quality-of-life patches for the Pi TUI. Starts with flush-edge code cards (copy button, raw-text toggle, mouse text selection, theme repaint) and selection release after copy.",
  "license": "MIT",
  "author": "witt <coder.witt@gmail.com>",
  "contributors": [
    {
      "name": "pi-code-render contributors",
      "url": "https://github.com/chengyayu/pi-code-render"
    }
  ],
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "coding-agent",
    "terminal-ui",
    "tui",
    "quality-of-life",
    "code-blocks",
    "code-rendering",
    "mouse-selection"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/witt-bit/pi-splinter.git"
  },
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node test/run.mjs"
  },
  "files": [
    "extensions",
    "src",
    "docs/modules",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/pi-splinter.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  }
}
